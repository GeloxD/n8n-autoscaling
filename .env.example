## n8n version - pin this explicitly and bump deliberately.
## Check https://github.com/n8n-io/n8n/releases before upgrading.
N8N_VERSION=2.32.6

## Reverse proxy (npmplus)
## Name of the external Docker network your npmplus container is also on.
## Create it once with: docker network create n8n-proxy
## Then attach npmplus to it in Portainer (or `docker network connect`).
PROXY_NETWORK_NAME=n8n-proxy

## Autoscaling
COMPOSE_PROJECT_NAME=n8n-autoscaling
COMPOSE_FILE_PATH=/app/docker-compose.yml
GENERIC_TIMEZONE=Asia/Kuala_Lumpur
MIN_REPLICAS=1
MAX_REPLICAS=3
SCALE_UP_QUEUE_THRESHOLD=5
SCALE_DOWN_QUEUE_THRESHOLD=1
POLLING_INTERVAL_SECONDS=10
COOLDOWN_PERIOD_SECONDS=10
POLL_INTERVAL_SECONDS=5
N8N_QUEUE_BULL_GRACEFULSHUTDOWNTIMEOUT=300
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=300
N8N_WORKER_SERVICE_NAME=n8n-worker

## Redis
## CHANGE THIS - Redis now requires a password (it didn't before, and was
## previously reachable from anything that could reach the container).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
QUEUE_NAME_PREFIX=bull
QUEUE_NAME=jobs
QUEUE_BULL_REDIS_HOST=redis
QUEUE_HEALTH_CHECK_ACTIVE=true

## Postgres
## CHANGE THIS - generate your own strong password, don't reuse this or any
## value that was ever committed to git history.
POSTGRES_HOST=postgres
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
PGDATA=/var/lib/postgresql/data/pgdata
DB_TYPE=postgresdb

## N8N
N8N_HOST=automate.corderocloud.com
N8N_WEBHOOK=automate.corderocloud.com
N8N_WEBHOOK_URL=https://automate.corderocloud.com
WEBHOOK_URL=https://automate.corderocloud.com
N8N_EDITOR_BASE_URL=https://automate.corderocloud.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_USER_FOLDER=/n8n/main
## npmplus terminates TLS for you, so cookies traveling n8n<->npmplus over
## the internal Docker network don't need the Secure flag. Leave false
## unless you terminate TLS somewhere n8n can see it directly.
N8N_SECURE_COOKIE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

## CHANGE THESE - generate your own (e.g. `openssl rand -base64 32`).
## If you already have a running instance with real data, do NOT change
## N8N_ENCRYPTION_KEY on migration - it must match the value used when your
## existing credentials were saved, or they become unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME_JWT_SECRET

EXECUTIONS_MODE=queue
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

## System utilities available in Code nodes
NODE_FUNCTION_ALLOW_EXTERNAL=ajv,ajv-formats,ffmpeg,git,graphicsmagick,openssh-client
